# ---- ContaVen - Frontend de ADMINISTRACIÓN (Next.js) ----
# Copia este archivo como ".env.local" (o ".env") y llénalo con los datos
# de tu proyecto. El archivo con los valores reales NO se sube a GitHub.
#
# OJO: aquí solo van variables NEXT_PUBLIC_*, que SÍ se incrustan en el
# bundle del navegador. Por eso nunca debes poner aquí la secret key de
# Supabase: esa va solo en el backend de administración.

# Dónde se saca: Supabase > Project Settings > API Keys
# La publishable key es pública y está diseñada para usarse en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección del backend Flask de ADMINISTRACIÓN, sin barra final.
#
# En local:  http://localhost:5002
# En Vercel: la URL del proyecto del backend de admin, p. ej.
#   https://conta-ven-adm-back-end.vercel.app
#
# Sin esta variable la app no sabe a qué backend llamar y el login falla
# sin dar más información.
NEXT_PUBLIC_URL_API=http://localhost:5002
